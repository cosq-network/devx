# Copy this file to .env for local development. Never commit .env or secrets.

DEVX_PROVIDER=openrouter
DEVX_BASE_URL=https://openrouter.ai/api/v1
DEVX_API_KEY=sk-or-v1-replace-with-your-openrouter-key
DEVX_MODEL=openrouter/free
# Safety and execution limits
DEVX_APPROVAL_REQUIRED=true
DEVX_MAX_ITERATIONS=8
DEVX_MAX_TOOL_CALLS=40
DEVX_COMMAND_TIMEOUT=120
DEVX_TEST_COMMAND=
DEVX_MAX_FILE_BYTES=1000000
DEVX_MAX_CONTEXT_FILES=5
DEVX_LINT_COMMAND=
DEVX_CONTEXT_COMPACTION_ENABLED=true
DEVX_MAX_CONTEXT_MESSAGES=24
DEVX_MAX_CONTEXT_CHARS=24000
DEVX_COMPACTION_SUMMARY_CHARS=4000
DEVX_DIAGNOSTIC_DISTILLATION_ENABLED=true
DEVX_DIAGNOSTIC_DISTILLATION_MAX_CHARS=4000
DEVX_DECOUPLED_CONTEXT_ENABLED=true

# Optional local semantic optimization
DEVX_EMBEDDINGS_ENABLED=false
DEVX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVX_EMBEDDING_CACHE_DIR=~/.cache/devx/embeddings
DEVX_EMBEDDINGS_OFFLINE=false

# Optional tracing
LANGSMITH_TRACING=false
