# Copy this file to .env for local development. Never commit .env or secrets.
#
# devx resolves settings in this order: environment variables > workspace ./env
# > ~/.devx/config.env > .devx/config.json > built-in defaults.
# Legacy DEV_* names are also accepted for every DEVX_* variable below.

# ── Provider ──────────────────────────────────────────────────────────
DEVX_PROVIDER=openrouter
DEVX_BASE_URL=https://openrouter.ai/api/v1
# Use a real key here (or in ~/.devx/config.env, or an environment variable).
# Placeholders use <angle brackets> so the secret guard does not flag this file:
DEVX_API_KEY=<your-openrouter-api-key>
DEVX_MODEL=openrouter/free

# ── Safety and execution limits ───────────────────────────────────────
DEVX_APPROVAL_REQUIRED=true
DEVX_MAX_ITERATIONS=8
DEVX_MAX_TOOL_CALLS=40
DEVX_COMMAND_TIMEOUT=120
DEVX_TEST_COMMAND=
DEVX_LINT_COMMAND=
DEVX_MAX_FILE_BYTES=1000000
DEVX_MAX_CONTEXT_FILES=5
DEVX_CONTEXT_COMPACTION_ENABLED=true
DEVX_MAX_CONTEXT_MESSAGES=24
DEVX_MAX_CONTEXT_CHARS=24000
DEVX_COMPACTION_SUMMARY_CHARS=4000
DEVX_DIAGNOSTIC_DISTILLATION_ENABLED=true
DEVX_DIAGNOSTIC_DISTILLATION_MAX_CHARS=4000
DEVX_DECOUPLED_CONTEXT_ENABLED=true
DEVX_AUTO_CONTEXT=true

# ── Workspace / governed remote execution ─────────────────────────────
# DEVX_WORKSPACE=            # workspace root (default: current directory)
# DEVX_REMOTE_SSH=           # e.g. deploy@host:/srv/app or ssh://deploy@host:2222/srv/app
# DEVX_SSH_KEY=              # path to the SSH private key for --remote
# DEVX_CONTAINER=            # e.g. container://devx-lab-ab12cd34/config/repo
# DEVX_POLICY_PRESET=        # default | remote_only | deny_local_writes | protected | strict
DEVX_SECRET_SCAN=warn        # off | warn | redact | block
# DEVX_SESSION_DB=           # SQLite session database path (default ~/.devx/sessions.db)
# DEVX_CACHE_DB=             # Semantic cache database path (default ~/.devx/cache.db)

# ── Optional local semantic optimization ──────────────────────────────
DEVX_EMBEDDINGS_ENABLED=false
DEVX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVX_EMBEDDING_CACHE_DIR=~/.cache/devx/embeddings
DEVX_EMBEDDINGS_OFFLINE=false

# ── Optional tracing ──────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=devx-coding-agent

# ── Lab / e2e infrastructure ──────────────────────────────────────────
# Container image used by `devx lab up` and the opt-in SSH e2e suite
# (DEVX_E2E_REMOTE=1). The e2e suite also accepts DEVX_E2E_SSH=user@host:/path
# plus optional DEVX_E2E_SSH_PORT, DEVX_E2E_SSH_KEY, and DEVX_E2E_SSH_PASSWORD.
DEVX_E2E_IMAGE=lscr.io/linuxserver/openssh-server:latest